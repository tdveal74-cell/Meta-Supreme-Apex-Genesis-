# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meta_supreme

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Provider: mock | anthropic | openai
DEFAULT_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
AI_MAX_TOKENS_PER_AGENT=1200
AI_MAX_TOKENS_SYNTHESIS=2000

COUNCIL_PARALLEL_EXECUTION=false
COUNCIL_HISTORY_LIMIT=10

LOG_LEVEL=INFO
