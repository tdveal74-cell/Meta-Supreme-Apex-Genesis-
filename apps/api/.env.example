# Application
ENVIRONMENT=development
DEBUG=true
# Required on any deployed process. Generate one: openssl rand -hex 32
SECRET_KEY=

# Who may create an account. Unset closes registration entirely; a value of
# at least 16 characters opens it to holders of the key (sent as
# registration_key in the body or the X-Devon-Registration-Key header).
DEVON_REGISTRATION_KEY=
# Provider spend per account per UTC day, input plus output tokens, across
# every lane that reaches a provider. Refused with 429 once reached. 0
# disables the refusal; the provider_usage ledger still records.
PROVIDER_DAILY_TOKEN_CAP=500000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meta_supreme

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Provider: mock | anthropic | openai
DEFAULT_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
AI_MAX_TOKENS_PER_AGENT=1200
AI_MAX_TOKENS_SYNTHESIS=2000
AI_MAX_TOKENS_AGENT_TURN=600
AI_TURN_HISTORY_MAX_MESSAGES=12
AI_TURN_HISTORY_MAX_CHARS=12000
AI_TURN_OBSERVATIONS_MAX_CHARS=6000

COUNCIL_PARALLEL_EXECUTION=false
COUNCIL_HISTORY_LIMIT=10

# DEVON -> self-hosted EditForge. Use the same value as EditForge's
# EDITFORGE_MCP_TOKEN; DEVON never returns it from the API.
EDITFORGE_URL=http://localhost:3100
EDITFORGE_TOKEN=
EDITFORGE_TIMEOUT_SECONDS=60

LOG_LEVEL=INFO
