FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# The repository-root API is the canonical DEVON runtime. Keeping Railway on
# the same package CI exercises prevents the old apps/api mirror from drifting
# away from passkeys, Cerebras, persona, approvals, and agent execution.
#
# requirements.txt is the pip-compile --generate-hashes output of
# requirements.in (audit section 9 item 17): every direct and transitive
# package, pinned and hashed. --require-hashes makes this build fail
# outright, rather than silently resolve something else, if the file is
# ever edited by hand instead of regenerated, or if a transitive version
# moves between the compile and the build.
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

COPY app/ ./app/
COPY services/ ./services/
COPY database/ ./database/
COPY docs/ ./docs/
COPY alembic.ini ./alembic.ini
# The schedule dispatcher's entrypoint, so the documented cron line
# (cd /app && python dispatch.py) runs inside this image.
COPY dispatch.py ./dispatch.py

EXPOSE 8000

# Advance the durable schema before accepting traffic. Alembic is idempotent
# at head, so ordinary restarts are a no-op; a failed migration prevents an
# API process from starting against an incompatible schema.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
