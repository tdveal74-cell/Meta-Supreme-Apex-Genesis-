# Production image for the Next.js workspace: build once, serve with
# `next start`. The dev image (Dockerfile.web) mounts the source and runs
# `pnpm dev`; this one copies nothing at runtime that was not built.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# they are build args here rather than runtime environment. Changing the API
# or presence URL means rebuilding this image, which is a property of Next.js
# rather than a choice made here.

FROM node:22.22-bookworm-slim AS deps

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/ ./packages/

# The lockfile pins the overridden transitives (postcss, nanoid, sharp);
# --frozen-lockfile refuses to build if package.json and the lock disagree.
RUN pnpm install --frozen-lockfile --filter @meta-supreme/web...


FROM deps AS build

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_PRESENCE_URL
ARG NEXT_PUBLIC_DEVON_AVATAR_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_PRESENCE_URL=${NEXT_PUBLIC_PRESENCE_URL} \
    NEXT_PUBLIC_DEVON_AVATAR_URL=${NEXT_PUBLIC_DEVON_AVATAR_URL} \
    NEXT_TELEMETRY_DISABLED=1

COPY apps/web/ ./apps/web/
RUN pnpm --filter @meta-supreme/web build


FROM node:22.22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# The whole built workspace, node_modules included. A standalone output
# trace would be smaller; it is not enabled in next.config.mjs today and
# enabling it is a change to the web build, not to this image.
COPY --from=build /app /app

USER node
EXPOSE 3000
WORKDIR /app/apps/web
CMD ["pnpm", "start"]
