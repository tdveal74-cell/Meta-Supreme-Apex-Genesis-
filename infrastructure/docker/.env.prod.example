# Copy to infrastructure/docker/.env.prod and fill in. Never commit the copy:
# .env.prod is listed in .gitignore; this example is the only env file tracked.
#
#   docker compose --env-file infrastructure/docker/.env.prod \
#     -f infrastructure/docker/docker-compose.prod.yml config   # validate first
#
# Every line marked REQUIRED makes compose refuse to start when empty.

# --- Postgres (REQUIRED) ----------------------------------------------------
POSTGRES_PASSWORD=

# --- API and presence (REQUIRED) --------------------------------------------
# openssl rand -hex 32. Signs every DEVON JWT; both the API and the presence
# service verify sessions against it. HS256 means a verifier can also sign,
# so this is one key across two services. That is an open item for Tee's
# ruling (asymmetric tokens, or the presence service asking the API to
# verify, would close it); nothing here pretends it is settled. Receipts are
# NOT signed under it (see RECEIPT_SIGNING_KEY).
SECRET_KEY=
# openssl rand -hex 32. Signs every Universal Receipt. Reaches the API only.
# Empty derives a receipt key from SECRET_KEY, which starts but keeps the
# blast radius of a leaked SECRET_KEY; a dedicated value is the setting to
# run with. To rotate: move the old value into the PREVIOUS list, set the
# new one here. Old receipts keep verifying and report which key signed them.
RECEIPT_SIGNING_KEY=
RECEIPT_SIGNING_KEYS_PREVIOUS=
# JSON list of browser origins allowed to call the API and presence service.
CORS_ORIGINS=["https://devon.example.com"]
# Passkeys bind to the public hostname and origin of the web surface.
PASSKEY_RP_ID=devon.example.com
PASSKEY_ORIGIN=https://devon.example.com

# --- Web build (REQUIRED, baked into the bundle at build time) --------------
NEXT_PUBLIC_API_URL=https://api.devon.example.com/api/v1
NEXT_PUBLIC_PRESENCE_URL=https://presence.devon.example.com
# Optional: a GLB with ARKit blendshapes. Tee's owned likeness, never stock.
NEXT_PUBLIC_DEVON_AVATAR_URL=

# --- Providers ---------------------------------------------------------------
# mock starts with no keys and reports "simulated" on /health. Set cerebras
# (or anthropic, openai) together with its key to go live: a provider named
# without its key refuses to start, and web waits on that health.
DEFAULT_AI_PROVIDER=mock
ENRICHMENT_PROVIDER=mock
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PROVIDER_DAILY_TOKEN_CAP=500000

# --- Presence ---------------------------------------------------------------
# Same rule: mock until the key exists. With keys, cerebras primary and
# anthropic fallback is the intended pairing for the breaker to shift between.
PRESENCE_INFERENCE=mock
PRESENCE_FALLBACK_INFERENCE=
# mock until the Cartesia adapter is verified against the vendor.
PRESENCE_SPEECH=mock
PRESENCE_TTFT_THRESHOLD_MS=500
PRESENCE_WINDOW_MS=250
CARTESIA_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Registration and the human shell ---------------------------------------
# Unset closes registration; 16+ characters opens it to holders of the key.
DEVON_REGISTRATION_KEY=
# The second factor for the real shell. Unset disables the shell.
DEVON_SHELL_KEY=

# --- EditForge ---------------------------------------------------------------
EDITFORGE_URL=
EDITFORGE_TOKEN=

# --- n8n (only with: docker compose --profile executor up) ------------------
# Do not start this beside the VPS executor at n8n.editforge.online.
N8N_ENCRYPTION_KEY=
N8N_HOST=n8n.devon.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.devon.example.com/
N8N_EDITOR_BASE_URL=https://n8n.devon.example.com/
GENERIC_TIMEZONE=America/New_York
