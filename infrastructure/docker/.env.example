# Copy to .env — never commit secrets
POSTGRES_PASSWORD=change_me
ANTHROPIC_API_KEY=

# DEVON -> self-hosted EditForge. EDITFORGE_TOKEN must be the same value as the
# studio's own EDITFORGE_MCP_TOKEN — EditForge authenticates this bearer against
# that variable, so a mismatch answers 401 on every command. DEVON's status read
# verifies it against the authenticated /api/edits lane rather than the open
# /api/health route, and reports live_verified: false when it does not match.
# host.docker.internal reaches a studio running on the host; compose already
# maps it to the host gateway.
EDITFORGE_URL=http://host.docker.internal:3100
EDITFORGE_TOKEN=
