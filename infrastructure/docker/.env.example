# Copy to .env — never commit secrets
POSTGRES_PASSWORD=change_me
# Required: compose refuses to start without it. Generate one: openssl rand -hex 32
SECRET_KEY=
ANTHROPIC_API_KEY=

# Who may create an account. Unset closes registration entirely; a value of
# at least 16 characters opens it to holders of the key (sent as
# registration_key in the body or the X-Devon-Registration-Key header).
DEVON_REGISTRATION_KEY=
# Provider spend per account per UTC day, input plus output tokens, across
# every lane that reaches a provider. Refused with 429 once reached. 0
# disables the refusal; the provider_usage ledger still records.
PROVIDER_DAILY_TOKEN_CAP=500000

# DEVON -> self-hosted EditForge. EDITFORGE_TOKEN must be the same value as the
# studio's own EDITFORGE_MCP_TOKEN — EditForge authenticates this bearer against
# that variable, so a mismatch answers 401 on every command. DEVON's status read
# verifies it against the authenticated /api/edits lane rather than the open
# /api/health route, and reports live_verified: false when it does not match.
# host.docker.internal reaches a studio running on the host; compose already
# maps it to the host gateway.
EDITFORGE_URL=http://host.docker.internal:3100
EDITFORGE_TOKEN=
