{
  "model": "opus",
  "ultracode": true,
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "agentic-guardrails@meta-supreme-pinned": true,
    "backend-security-skills@meta-supreme-pinned": true,
    "test-generator@meta-supreme-pinned": true,
    "agent-archive@synced": false
  },
  "extraKnownMarketplaces": {
    "meta-supreme-pinned": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_ledger.py\" pre; rc=$?; [ $rc -eq 0 ] || { echo \"gate_ledger hook failed rc=$rc\" >&2; exit 1; }",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_ledger.py\" post; rc=$?; [ $rc -eq 0 ] || { echo \"gate_ledger hook failed rc=$rc\" >&2; exit 1; }",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_ledger.py\" fail; rc=$?; [ $rc -eq 0 ] || { echo \"gate_ledger hook failed rc=$rc\" >&2; exit 1; }",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "blotato-help",
    "graphify"
  ],
  "permissions": {
    "allow": [
      "mcp__Remote_Desktop_Commander",
      "mcp__claude_ai_Remote_Desktop_Commander",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(sha256sum:*)",
      "mcp__github__get_me",
      "mcp__github__get_file_contents",
      "mcp__github__get_commit",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__search_code",
      "mcp__github__search_pull_requests",
      "mcp__github__search_issues",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__resolve_review_thread"
    ]
  }
}
